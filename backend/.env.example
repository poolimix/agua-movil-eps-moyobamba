# ==========================================
# CONFIGURACIÓN GENERAL BACKEND
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# BASE DE DATOS POSTGRESQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aguamovil
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# SEGURIDAD JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_aguamovil_2026

# ==========================================
# NOTIFICACIONES: META WHATSAPP CLOUD API
# ==========================================
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_TEMPLATE_NAME=eps_moyobamba_vale_agua

# ==========================================
# NOTIFICACIONES: SMS GATEWAY (TWILIO)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# NOTIFICACIONES: CORREO ELECTRÓNICO (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@epsmoyobamba.gob.pe
SMTP_PASS=your_app_password
SMTP_FROM="EPS Moyobamba - Agua Móvil" <notificaciones@epsmoyobamba.gob.pe>
