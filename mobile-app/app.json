{
  "expo": {
    "name": "AguaTrack",
    "slug": "aguatrack",
    "scheme": "aguatrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.epsmoyobamba.aguatrack"
    },
    "android": {
      "package": "com.epsmoyobamba.aguatrack",
      "adaptiveIcon": {
        "backgroundColor": "#0284c7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite capturar evidencia fotográfica de las entregas de agua."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite registrar las coordenadas GPS de la cisterna durante el reparto."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a2d50ddf-6917-41eb-a72b-2d33d2a4288f"
      }
    },
    "owner": "poolimix"
  }
}
